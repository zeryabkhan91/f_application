{
  "openapi": "3.0.3",
  "info": {
    "title": "F Application API",
    "version": "0.1.0",
    "description": "Factory management API. Organization routes require an authenticated session; each documents its required permission."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["path", "message"],
                  "additionalProperties": false
                }
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": ["code", "message", "requestId"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "LiveHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "ReadyHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ready"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "UnavailableHealth": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["not_ready"]
          }
        },
        "required": ["status"],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Process liveness",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Process is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealth"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Database and process readiness",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Ready for requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealth"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or shutting down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnavailableHealth"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1": {
      "get": {
        "operationId": "getServiceInfo",
        "summary": "API identity and version",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": ["f-application-api"]
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": ["name", "version"],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "`RATE_LIMITED`: Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "`INTERNAL_ERROR`: Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
