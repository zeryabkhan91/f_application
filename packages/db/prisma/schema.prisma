generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Private S3 object metadata. Business entities and ownership belong in later migrations.
model StoredObject {
  id          String   @id @default(uuid()) @db.Uuid
  bucket      String   @db.VarChar(63)
  objectKey   String   @map("object_key") @db.VarChar(1024)
  contentType String   @map("content_type") @db.VarChar(255)
  sizeBytes   BigInt   @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([bucket, objectKey])
  @@map("stored_objects")
}
