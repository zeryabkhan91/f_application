// Factory Management System database foundation.
// See docs/architecture/database.md for ownership, constraints, and RLS rules.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum RoleCode {
  OWNER
  ADMIN
  ACCOUNTS
  SALES
  PRODUCTION
  WAREHOUSE
  VIEWER
  CUSTOM
}

enum NumberSequenceType {
  INVOICE
  ORDER
  PURCHASE
  PAYMENT
  SUPPLIER_PAYMENT
  SUPPLIER_INVOICE
  GOODS_RECEIPT
  PRODUCTION
  DISPATCH
  EXPENSE
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  DRAFT
  POSTED
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  PARTIALLY_DISPATCHED
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ScheduleType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ScheduleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum InventoryItemType {
  RAW_MATERIAL
  PRODUCT
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  SALE_DISPATCH
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum InventoryReferenceType {
  GOODS_RECEIPT
  PRODUCTION_ORDER
  DISPATCH
  ADJUSTMENT
  RETURN
  TRANSFER
}

enum BillOfMaterialStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DispatchStatus {
  DRAFT
  POSTED
  DELIVERED
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  POSTED
  VOID
}

enum AttachmentEntityType {
  SUPPLIER
  CUSTOMER
  RAW_MATERIAL
  PRODUCT
  PURCHASE_ORDER
  SUPPLIER_INVOICE
  SUPPLIER_PAYMENT
  SALES_ORDER
  SALES_INVOICE
  CUSTOMER_PAYMENT
  DISPATCH
  PRODUCTION_ORDER
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  VOID
  CANCEL
  PAYMENT
  STATUS_CHANGE
  DELETE_MASTER_RECORD
  REVERSE
}

enum NotificationType {
  CUSTOMER_PAYMENT_OVERDUE
  SUPPLIER_PAYMENT_DUE
  CUSTOMER_INSTALLMENT_DUE
  LOW_RAW_MATERIAL_STOCK
  ORDER_DELIVERY_APPROACHING
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @db.VarChar(160)
  email        String     @unique @db.Citext
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[] @relation("Membership_user")

  @@map("users")
}

model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(200)
  slug      String       @unique @db.Citext
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branding      TenantBranding? @relation("TenantBranding_tenant")
  organizations Organization[]  @relation("Organization_tenant")

  @@map("tenants")
}

model TenantBranding {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  applicationName String?  @map("application_name") @db.VarChar(160)
  logoUrl         String?  @map("logo_url")
  faviconUrl      String?  @map("favicon_url")
  primaryTheme    Json?    @map("primary_theme") @db.JsonB
  customDomain    String?  @unique @map("custom_domain") @db.Citext
  supportEmail    String?  @map("support_email") @db.Citext
  invoiceBranding Json?    @map("invoice_branding") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation("TenantBranding_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "tenant_branding_tenant_fkey")

  @@map("tenant_branding")
}

model Currency {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.Char(3)
  name      String   @db.VarChar(100)
  symbol    String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations            Organization[]         @relation("Organization_currency")
  settings                 OrganizationSettings[] @relation("OrganizationSettings_currency")
  supplier_currency        Supplier[]             @relation("Supplier_currency")
  customer_currency        Customer[]             @relation("Customer_currency")
  purchaseOrder_currency   PurchaseOrder[]        @relation("PurchaseOrder_currency")
  supplierInvoice_currency SupplierInvoice[]      @relation("SupplierInvoice_currency")
  salesOrder_currency      SalesOrder[]           @relation("SalesOrder_currency")
  salesInvoice_currency    SalesInvoice[]         @relation("SalesInvoice_currency")
  supplierPayment_currency SupplierPayment[]      @relation("SupplierPayment_currency")
  customerPayment_currency CustomerPayment[]      @relation("CustomerPayment_currency")
  expense_currency         Expense[]              @relation("Expense_currency")

  @@map("currencies")
}

model Country {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.Char(2)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[] @relation("Organization_country")

  @@map("countries")
}

model UnitDefinition {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  symbol    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizationUnits Unit[] @relation("Unit_definition")

  @@map("unit_definitions")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[] @relation("RolePermission_permission")

  @@map("permissions")
}

model Organization {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  name         String             @db.VarChar(200)
  slug         String             @db.Citext
  legalName    String?            @map("legal_name") @db.VarChar(200)
  phone        String?            @db.VarChar(40)
  email        String?            @db.Citext
  address      String?
  city         String?            @db.VarChar(100)
  countryCode  String             @default("PK") @map("country_code") @db.Char(2)
  currencyCode String             @default("PKR") @map("currency_code") @db.Char(3)
  timezone     String             @default("Asia/Karachi") @db.VarChar(80)
  taxNumber    String?            @map("tax_number") @db.VarChar(100)
  status       OrganizationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                                     Tenant                          @relation("Organization_tenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "organizations_tenant_fkey")
  country                                    Country                         @relation("Organization_country", fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Restrict, map: "organizations_country_fkey")
  currency                                   Currency                        @relation("Organization_currency", fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict, map: "organizations_currency_fkey")
  role_organization                          Role[]                          @relation("Role_organization")
  rolePermission_organization                RolePermission[]                @relation("RolePermission_organization")
  membership_organization                    Membership[]                    @relation("Membership_organization")
  organizationSettings_organization          OrganizationSettings?           @relation("OrganizationSettings_organization")
  numberSequence_organization                NumberSequence[]                @relation("NumberSequence_organization")
  unit_organization                          Unit[]                          @relation("Unit_organization")
  supplier_organization                      Supplier[]                      @relation("Supplier_organization")
  customer_organization                      Customer[]                      @relation("Customer_organization")
  rawMaterial_organization                   RawMaterial[]                   @relation("RawMaterial_organization")
  product_organization                       Product[]                       @relation("Product_organization")
  warehouse_organization                     Warehouse[]                     @relation("Warehouse_organization")
  expenseCategory_organization               ExpenseCategory[]               @relation("ExpenseCategory_organization")
  purchaseOrder_organization                 PurchaseOrder[]                 @relation("PurchaseOrder_organization")
  purchaseOrderItem_organization             PurchaseOrderItem[]             @relation("PurchaseOrderItem_organization")
  goodsReceipt_organization                  GoodsReceipt[]                  @relation("GoodsReceipt_organization")
  goodsReceiptItem_organization              GoodsReceiptItem[]              @relation("GoodsReceiptItem_organization")
  supplierInvoice_organization               SupplierInvoice[]               @relation("SupplierInvoice_organization")
  supplierInvoiceItem_organization           SupplierInvoiceItem[]           @relation("SupplierInvoiceItem_organization")
  salesOrder_organization                    SalesOrder[]                    @relation("SalesOrder_organization")
  salesOrderItem_organization                SalesOrderItem[]                @relation("SalesOrderItem_organization")
  salesInvoice_organization                  SalesInvoice[]                  @relation("SalesInvoice_organization")
  salesInvoiceItem_organization              SalesInvoiceItem[]              @relation("SalesInvoiceItem_organization")
  supplierPayment_organization               SupplierPayment[]               @relation("SupplierPayment_organization")
  customerPayment_organization               CustomerPayment[]               @relation("CustomerPayment_organization")
  supplierPaymentAllocation_organization     SupplierPaymentAllocation[]     @relation("SupplierPaymentAllocation_organization")
  paymentSchedule_organization               PaymentSchedule[]               @relation("PaymentSchedule_organization")
  paymentInstallment_organization            PaymentInstallment[]            @relation("PaymentInstallment_organization")
  customerPaymentAllocation_organization     CustomerPaymentAllocation[]     @relation("CustomerPaymentAllocation_organization")
  billOfMaterial_organization                BillOfMaterial[]                @relation("BillOfMaterial_organization")
  billOfMaterialItem_organization            BillOfMaterialItem[]            @relation("BillOfMaterialItem_organization")
  productionOrder_organization               ProductionOrder[]               @relation("ProductionOrder_organization")
  productionMaterialConsumption_organization ProductionMaterialConsumption[] @relation("ProductionMaterialConsumption_organization")
  productionOutput_organization              ProductionOutput[]              @relation("ProductionOutput_organization")
  expense_organization                       Expense[]                       @relation("Expense_organization")
  dispatch_organization                      Dispatch[]                      @relation("Dispatch_organization")
  dispatchItem_organization                  DispatchItem[]                  @relation("DispatchItem_organization")
  inventoryMovement_organization             InventoryMovement[]             @relation("InventoryMovement_organization")
  inventoryBalance_organization              InventoryBalance[]              @relation("InventoryBalance_organization")
  storedObject_organization                  StoredObject[]                  @relation("StoredObject_organization")
  attachment_organization                    Attachment[]                    @relation("Attachment_organization")
  auditLog_organization                      AuditLog[]                      @relation("AuditLog_organization")
  idempotencyKey_organization                IdempotencyKey[]                @relation("IdempotencyKey_organization")
  notification_organization                  Notification[]                  @relation("Notification_organization")

  @@unique([tenantId, id], map: "organizations_tenant_id_id_key")
  @@unique([tenantId, slug], map: "organizations_tenant_id_slug_key")
  @@map("organizations")
}

model Role {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           RoleCode
  name           String       @db.VarChar(100)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermission_role RolePermission[] @relation("RolePermission_role")
  membership_role     Membership[]     @relation("Membership_role")
  organization        Organization     @relation("Role_organization", fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "roles_organization_fkey")

  @@unique([tenantId, organizationId, id], map: "roles_tenant_id_organization_id_id_key")
  @@unique([tenantId, organizationId, name], map: "roles_tenant_id_organization_id_name_key")
  @@index([organizationId], map: "roles_organization_id_idx")
  @@index([tenantId, organizationId, createdAt], map: "roles_tenant_id_organization_id_created_at_idx")
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permissionId   String   @map("permission_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role         Role         @relation("RolePermission_role", fields: [tenantId, organizationId, roleId], references: [tenantId, organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "role_permissions_role_fkey")
  permission   Permission   @relation("RolePermission_permission", fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "role_permissions_permission_fkey")
  organization Organization @relation("RolePermission_organization", fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "role_permissions_organization_fkey")

  @@unique([tenantId, organizationId, id], map: "role_permissions_tenant_id_organization_id_id_key")
  @@unique([tenantId, organizationId, roleId, permissionId], map: "role_permissions_tenant_id_organization_id_role_id_per_1788d5be")
  @@index([organizationId], map: "role_permissions_organization_id_idx")
  @@index([tenantId, organizationId, createdAt], map: "role_permissions_tenant_id_organization_id_created_at_idx")
  @@map("role_permissions")
}

