# Run npm run setup:local to generate a private local password and .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
ENABLE_API_DOCS=true

# The setup script replaces these example values. Use Secrets Manager in AWS.
DATABASE_USER=app
DATABASE_PASSWORD=replace-with-local-password
DATABASE_NAME=f_application
DATABASE_PORT=5432
DATABASE_URL=postgresql://app:replace-with-local-password@127.0.0.1:5432/f_application?schema=public
# npm run db:provision saves a restricted DATABASE_URL and retains this admin URL.
MIGRATION_DATABASE_URL=postgresql://app:replace-with-local-password@127.0.0.1:5432/f_application?schema=public

# Optional until document storage is configured. Prefer ECS task roles in AWS.
AWS_REGION=us-east-1
# S3_BUCKET=your-private-document-bucket
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true
